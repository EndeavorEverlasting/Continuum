{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/Continuum/schemas/lifecycle.schema.json",
  "title": "Continuum lifecycle contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "repository_role",
    "active_control_plane",
    "historical_version",
    "feature_development_allowed",
    "runtime_expansion_allowed",
    "reactivation_allowed",
    "reactivation_policy",
    "allowed_change_classes",
    "decision_record"
  ],
  "properties": {
    "$schema": {"const": "../schemas/lifecycle.schema.json"},
    "schema_version": {"const": 1},
    "status": {"const": "dormant"},
    "repository_role": {"const": "preserved-reference"},
    "active_control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "role"],
      "properties": {
        "repository": {"const": "EndeavorEverlasting/AgentSwitchboard"},
        "role": {"const": "active-control-plane"}
      }
    },
    "historical_version": {"type": "string", "minLength": 1},
    "feature_development_allowed": {"const": false},
    "runtime_expansion_allowed": {"const": false},
    "reactivation_allowed": {"const": false},
    "reactivation_policy": {"const": "new-explicit-architecture-decision-only"},
    "allowed_change_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "security-fix",
          "dependency-fix",
          "archival-maintenance",
          "documentation-correction"
        ]
      }
    },
    "decision_record": {"const": "docs/adr/0001-continuum-dormant.md"}
  }
}
